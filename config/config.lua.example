return {
  name = "echo-bot",
  token = os.getenv("TELEGRAM_BOT_TOKEN"),
  mode = "webhook", -- webhook or polling
  listen_host = "127.0.0.1",
  listen_port = 8080,
  webhook_path = "/telegram/webhook",
  webhook_secret = os.getenv("TELEGRAM_WEBHOOK_SECRET"),
  tls = { cert = "certs/server.crt", key = "certs/server.key", ca = nil, mtls = false },
  workers = 9,
  queue_capacity = 1024,
  spool_path = "/var/lib/ll-lua/updates.spool",
  dead_letter_path = "/var/lib/ll-lua/dead-letter.spool",
  max_retries = 8,
  poll_timeout = 25,
  poll_limit = 100,
  storage = nil -- set to a developer-owned ll-lua.storage.Store implementation
}
